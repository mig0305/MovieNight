# Copy this file to .env and fill in real values. .env is git-ignored.

PORT=3000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/movie-night locally)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/movie-night

# Long random string. Make one with:
#   node -p "crypto.randomBytes(32).toString('hex')"
JWT_SECRET=change-me

# The React (Vite) app's origin, no trailing slash
CLIENT_ORIGIN=http://localhost:5173

# TMDB "API Read Access Token" (v4 auth), from themoviedb.org > Settings > API
TMDB_TOKEN=your-tmdb-read-access-token
TMDB_BASE_URL=https://api.themoviedb.org/3
